{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 1
    }
  },
  "display": {
    "separator": " ➜ "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "wm",
   {
          "type": "cpu",
          "format": "{1}"
        },
        "memory",
  ]
}
